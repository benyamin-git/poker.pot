{
  "name": "poker.pot",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "bun src/server/index.ts",
    "screenshots": "bun run build && bun scripts/screenshots.ts",
    "icons": "bun scripts/icons.ts",
    "tauri": "tauri",
    "android:init": "tauri android init --ci",
    "android:apk": "tauri android build --apk --ci",
    "version:set": "bun scripts/version-set.ts",
    "theme": "bun scripts/theme.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "dexie": "4.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "yaml": "^2.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^2.1.3"
  }
}
